{
  "opencollection": "1.0.0",
  "info": {
    "name": "AI Impact Measurement Model API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Model",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List models",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/model",
            "params": [
              {
                "name": "family",
                "value": "",
                "type": "query",
                "description": "Filter models by family"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List models"
        },
        {
          "info": {
            "name": "Create a model",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/model",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create a model"
        },
        {
          "info": {
            "name": "Get a specific model (global or custom)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/model/:modelId",
            "params": [
              {
                "name": "modelId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get a specific model (global or custom)"
        },
        {
          "info": {
            "name": "Update a model",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "{{baseUrl}}/model/:modelId",
            "params": [
              {
                "name": "modelId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Update a model"
        },
        {
          "info": {
            "name": "Delete a model",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/model/:modelId",
            "params": [
              {
                "name": "modelId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Delete a model"
        },
        {
          "info": {
            "name": "Add a new alias to a model",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "{{baseUrl}}/model/:modelId/alias",
            "params": [
              {
                "name": "modelId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Add a new alias to a model"
        },
        {
          "info": {
            "name": "Remove an alias from a model",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/model/:modelId/alias/:alias",
            "params": [
              {
                "name": "modelId",
                "value": "",
                "type": "path"
              },
              {
                "name": "alias",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Remove an alias from a model"
        }
      ]
    }
  ],
  "bundled": true
}