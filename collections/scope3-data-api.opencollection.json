{
  "opencollection": "1.0.0",
  "info": {
    "name": "AI Impact Measurement Data API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Data",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Upload Data File",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/data/upload",
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "file",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "type",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "fieldMapping",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "version",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "dataSource",
                  "type": "text",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Returns the uploaded data file status"
        },
        {
          "info": {
            "name": "Get Data File Upload by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/data/upload/:uploadId",
            "params": [
              {
                "name": "uploadId",
                "value": "",
                "type": "path",
                "description": "Numeric ID of the upload to get"
              }
            ]
          },
          "docs": "Returns requested data file upload information"
        }
      ]
    }
  ],
  "bundled": true
}