{
  "opencollection": "1.0.0",
  "info": {
    "name": "AI Impact Measurement Gpu API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Gpu",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List GPUs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/gpu",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List GPUs"
        },
        {
          "info": {
            "name": "Create a GPU",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/gpu",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create a GPU"
        },
        {
          "info": {
            "name": "Get a specific GPU (global or custom)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/gpu/:gpuId",
            "params": [
              {
                "name": "gpuId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get a specific GPU (global or custom)"
        },
        {
          "info": {
            "name": "Update a GPU",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "{{baseUrl}}/gpu/:gpuId",
            "params": [
              {
                "name": "gpuId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Update a GPU"
        },
        {
          "info": {
            "name": "Delete a GPU",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/gpu/:gpuId",
            "params": [
              {
                "name": "gpuId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Delete a GPU"
        }
      ]
    }
  ],
  "bundled": true
}