{
  "opencollection": "1.0.0",
  "info": {
    "name": "AI Impact Measurement Status API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Status",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/status"
          }
        }
      ]
    }
  ],
  "bundled": true
}