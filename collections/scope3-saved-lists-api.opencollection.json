{
  "opencollection": "1.0.0",
  "info": {
    "name": "AI Impact Measurement Saved Lists API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Saved Lists",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Saved Lists",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/saved_lists"
          },
          "docs": "Returns all property lists available for the authenticated customer, including list ID, name, and domain count."
        }
      ]
    }
  ],
  "bundled": true
}